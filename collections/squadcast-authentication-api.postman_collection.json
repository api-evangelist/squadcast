{
  "item": [
    {
      "id": "27154da1-b5ee-4cd7-821d-ed54e21fddbf",
      "name": "Authentication",
      "description": {
        "content": "Token exchange endpoints",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a8a4426b-75cd-4026-ac13-6b703d9e8337",
          "name": "Exchange refresh token for access token",
          "request": {
            "name": "Exchange refresh token for access token",
            "description": {
              "content": "Exchange a long-lived refresh token (passed in the `X-Refresh-Token`\nheader) for a short-lived bearer access token used on all other API\ncalls. Call this against the auth host (`auth.squadcast.com` or\n`auth.eu.squadcast.com`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "access-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Long-lived refresh token issued from the Squadcast console.",
                "key": "X-Refresh-Token",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a270271b-ca6f-4604-9f73-73eaf9a7de46",
              "name": "Access token issued successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "oauth",
                    "access-token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) Long-lived refresh token issued from the Squadcast console.",
                    "key": "X-Refresh-Token",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"expires_at\": \"2006-06-05T11:04:08.013Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
              "id": "aa01ce0d-5ea4-4e2e-a060-8d4b622c284b",
              "name": "Invalid or missing refresh token",
              "originalRequest": {
                "url": {
                  "path": [
                    "oauth",
                    "access-token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) Long-lived refresh token issued from the Squadcast console.",
                    "key": "X-Refresh-Token",
                    "value": "<string>"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.squadcast.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "e3fa6681-76ad-42f4-bbb3-cae74233721c",
    "name": "Squadcast Public Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Public REST API for the Squadcast (SolarWinds Incidents Cloud) incident\nresponse and on-call management platform. The API exposes incident\nmanagement operations — including bulk acknowledge/resolve, individual\nincident lookup, reassignment, priority updates, exports, and request\nstatus checks.\n\nAuthentication uses HTTP Bearer access tokens. Access tokens are\nshort-lived and exchanged from a long-lived refresh token via the\n`/oauth/access-token` endpoint on the auth host. Send subsequent API\nrequests with `Authorization: Bearer <access_token>` against the regional\nAPI host.\n\n\nContact Support:\n Name: Squadcast Support",
      "type": "text/plain"
    }
  }
}